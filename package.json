{
  "name": "creator-hustle",
  "private": true,
  "version": "1.0.0",
  "description": "Creator Hustle: a 3D isometric tycoon game about building a Nigerian digital creator business.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
